{
    "stylua.targetReleaseVersion": "latest",
    "editor.formatOnSave": true,
    "files.eol": "\n",
    "files.exclude": {
        "**/*.lock": true,
        "**/*.lock.*": true,
        "**/*-lock.*": true,
        "**/*_packages": true,
        "**/.pesde": true,
        ".gitattributes": true,
        ".gitignore": true,
        ".github": true,
        ".luaurc": true,
        ".claude": true,
        ".vscode": true,
        ".env": true,
        ".zed": true,
        "package.json": true,
        "aftman.toml": true,
        "stylua.toml": true,
        "wally.toml": true,
        "pesde.toml": true,
        "scripts": true
    },
    "files.readonlyInclude": {
        "**/LICENSE": true,
        "**/*.lock": true,
        "**/*.lock.*": true,
        "**/*-lock.*": true,
        "**/*_packages/**": true,
        "**/.pesde/**": true
    },
    "luau-lsp.platform.type": "standard",
    "luau-lsp.sourcemap.enabled": false,
    "luau-lsp.sourcemap.autogenerate": false,
    "luau-lsp.fflags.enableNewSolver": false,
    "luau-lsp.bytecode.vectorType": "Vector3",
    "luau-lsp.bytecode.vectorLib": "Vector3",
    "luau-lsp.bytecode.vectorCtor": "new",
    "luau-lsp.completion.imports.requireStyle": "alwaysAbsolute",
    "luau-lsp.completion.imports.stringRequires.enabled": true,
    "luau-lsp.completion.imports.ignoreGlobs": [
        "**/.pesde/**"
    ],
    "luau-lsp.ignoreGlobs": [
        "**/*_packages/**",
        "**/.pesde/**"
    ],
}